# Domain for Twilio webhook URLs (will be replaced by your Zeabur domain)
DOMAIN=your-zeabur-domain.zeabur.app

# Server Port
PORT=3000

# Twilio Configuration (required for all call functionality)
# Get these from https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+19206968892  # Your Twilio phone number

# ElevenLabs API Key (required for TTS — get from https://elevenlabs.io)
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optionally: Set a default voice
ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM

# Whisper Configuration (optional, local STT)
# Set to 'true' to use local Whisper instead of ElevenLabs STT
USE_LOCAL_WHISPER=false

# Skip whisper-node installation check
WHISPER_SKIP_CHECK=false

# Optional: Custom voice names mapped to ElevenLabs voice IDs
# SIMPLE_VOICES=adam=BIZkB3cCqWh1eUU3dm7vSarah,role=1
SIMPLE_VOICES=
